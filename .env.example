# Токен от @BotFather (не коммитьте реальный .env)
BOT_TOKEN=

# Username бота без @ — для ссылок на лендинге (например NorthlineLeadBot)
BOT_USERNAME=

# Кому слать карточки заявок в Telegram (numeric chat id).
# Узнать свой: напишите боту /myid
# Несколько человек: 111111111,222222222
# Сменить менеджера: замените id и перезапустите npm start
MANAGER_CHAT_IDS=
